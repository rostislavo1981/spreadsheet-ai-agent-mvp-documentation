{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spreadsheet-agent.local/schemas/plan-request.schema.json",
  "title": "Plan request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "client", "workbook", "selection", "context", "prompt", "conversation", "options"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "parent_run_id": {"type": ["string", "null"], "maxLength": 100},
    "client": {
      "type": "object", "additionalProperties": false, "required": ["type", "version", "tool_versions"],
      "properties": {
        "type": {"enum": ["google_sheets", "excel", "test"]},
        "version": {"type": "string", "maxLength": 50},
        "tool_versions": {"type": "object", "maxProperties": 100, "additionalProperties": {"type": "string", "maxLength": 20}}
      }
    },
    "workbook": {
      "type": "object", "additionalProperties": false, "required": ["workbook_id_hash", "locale", "timezone"],
      "properties": {
        "workbook_id_hash": {"type": "string", "minLength": 16, "maxLength": 200},
        "title": {"type": ["string", "null"], "maxLength": 200},
        "locale": {"type": "string", "maxLength": 30},
        "timezone": {"type": "string", "maxLength": 100}
      }
    },
    "selection": {"$ref": "#/$defs/target"},
    "context": {
      "type": "object", "additionalProperties": false, "required": ["ranges", "omissions"],
      "properties": {
        "ranges": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/range_context"}},
        "omissions": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/omission"}}
      }
    },
    "prompt": {"type": "string", "minLength": 1, "maxLength": 20000},
    "conversation": {
      "type": "array", "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["role", "content"],
        "properties": {"role": {"enum": ["user", "assistant"]}, "content": {"type": "string", "maxLength": 20000}}
      }
    },
    "options": {
      "type": "object", "additionalProperties": false, "required": ["profile", "data_class", "context_scope"],
      "properties": {
        "profile": {"type": "string", "minLength": 1, "maxLength": 100},
        "data_class": {"enum": ["public", "internal", "confidential", "restricted"]},
        "max_cost_usd": {"type": ["number", "null"], "minimum": 0},
        "context_scope": {"enum": ["selection", "selection_with_neighbors", "approved_custom_ranges"]},
        "model": {"type": ["string", "null"], "maxLength": 200},
        "client_run_token": {"type": ["string", "null"], "maxLength": 100}
      }
    }
  },
  "$defs": {
    "target": {
      "type": "object", "additionalProperties": false, "required": ["sheet_id", "sheet_name", "a1_range"],
      "properties": {"sheet_id": {"type": "integer"}, "sheet_name": {"type": "string", "minLength": 1, "maxLength": 100}, "a1_range": {"type": "string", "minLength": 1, "maxLength": 200}}
    },
    "json_cell": {"type": ["string", "number", "boolean", "null", "object"]},
    "range_context": {
      "type": "object", "additionalProperties": false,
      "required": ["sheet_id", "sheet_name", "a1_range", "start_row", "start_column", "row_count", "column_count", "values", "display_values", "formulas", "fingerprint"],
      "properties": {
        "sheet_id": {"type": "integer"}, "sheet_name": {"type": "string", "minLength": 1, "maxLength": 100}, "a1_range": {"type": "string", "minLength": 1, "maxLength": 200},
        "start_row": {"type": "integer", "minimum": 1}, "start_column": {"type": "integer", "minimum": 1}, "row_count": {"type": "integer", "minimum": 1, "maximum": 10000}, "column_count": {"type": "integer", "minimum": 1, "maximum": 1000},
        "values": {"type": "array", "items": {"type": "array", "items": {"$ref": "#/$defs/json_cell"}}},
        "display_values": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
        "formulas": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
        "number_formats": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
        "merged_intersections": {"type": "array", "items": {"type": "string"}},
        "protected_intersections": {"type": "array", "items": {"type": "string"}},
        "fingerprint": {"type": "string", "minLength": 16, "maxLength": 200}
      }
    },
    "omission": {
      "type": "object", "additionalProperties": false, "required": ["reason"],
      "properties": {"reason": {"type": "string", "maxLength": 200}, "original_range": {"type": ["string", "null"], "maxLength": 200}, "detail": {"type": ["string", "null"], "maxLength": 1000}}
    }
  }
}

