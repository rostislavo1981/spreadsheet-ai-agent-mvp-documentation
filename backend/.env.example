# Spreadsheet AI Agent — backend environment (copy to .env, fill secrets).
# All provider/Hermes secrets stay server-side. Never commit this file.

# Runtime
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_SIGNING_SECRET=replace-with-random-secret
APP_ID_HASH_SALT=replace-with-different-random-salt
APP_CLIENT_TOKEN_HASHES=
SQLITE_DB_PATH=

# Limits (hard caps; see SECURITY_GUARDRAILS.md)
MAX_REQUEST_BYTES=4194304
MAX_SELECTED_CELLS=10000
MAX_CONTEXT_CELLS=10000
MAX_ACTIONS=100
MAX_CHANGED_CELLS=10000
MAX_INPUT_TOKENS=50000
MAX_OUTPUT_TOKENS=8000
MAX_PROVIDER_ATTEMPTS=3
PROVIDER_TIMEOUT_SECONDS=45
PREVIEW_TTL_SECONDS=600
APPROVAL_TTL_SECONDS=120
MAX_RUN_COST_USD=0.10
DAILY_USER_COST_USD=2.00
AUDIT_RETENTION_DAYS=30
SNAPSHOT_RETENTION_DAYS=7

# Rate limit
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=10

# Routing
ENABLED_PROVIDER_TARGETS=fake
DEFAULT_ROUTING_PROFILE=auto
ALLOW_UNKNOWN_PROVIDER_COST=false

# Fake provider (offline/dev)
FAKE_PROVIDER_ENABLED=true
FAKE_PROVIDER_FIXTURE=tests/fixtures/provider/read_only.json

# OpenAI-compatible (OpenAI / OpenRouter / Ollama-compatible)
OPENAI_COMPATIBLE_ENABLED=false
OPENAI_COMPATIBLE_PROVIDER_ID=compatible
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_EXTRA_HEADERS_JSON={}

# Hermes (Mode A: Hermes Gateway as OpenAI-compatible endpoint)
HERMES_ENABLED=false
HERMES_MODE=openai_compatible
HERMES_BASE_URL=http://127.0.0.1:57377/v1
HERMES_API_KEY=
HERMES_MODEL=spreadsheet-planner
HERMES_PROFILE=spreadsheet-planner
HERMES_TOOL_POLICY=planner_only
HERMES_SESSION_MODE=ephemeral
HERMES_TIMEOUT_SECONDS=45

# Observability (raw logging must stay false in normal use)
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_PROMPTS=false
LOG_SPREADSHEET_CONTEXT=false
LOG_SNAPSHOTS=false
